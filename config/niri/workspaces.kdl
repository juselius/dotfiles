workspace "mail"
workspace "web"
workspace "dev"
workspace "work"
workspace "config"

binds {
    Mod+1 { focus-workspace "mail"; }
    Mod+2 { focus-workspace "web"; }
    Mod+3 { focus-workspace "dev"; }
    Mod+4 { focus-workspace "work"; }
    Mod+Shift+1 { move-column-to-workspace "mail"; }
    Mod+Shift+2 { move-column-to-workspace "web"; }
    Mod+Shift+3 { move-column-to-workspace "dev"; }
    Mod+Shift+4 { move-column-to-workspace "work"; }
}
